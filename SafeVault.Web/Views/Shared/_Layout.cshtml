<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>SafeVault</title><link rel="stylesheet" href="~/css/site.css" /></head>
<body><header><a asp-controller="Home" asp-action="Index">SafeVault</a><nav>
<a asp-controller="Home" asp-action="Index">Home</a>
@if (User.Identity?.IsAuthenticated == true) {
<a asp-controller="Home" asp-action="Profile">Profile</a>
@if(User.IsInRole("Admin")) { <a asp-controller="Admin" asp-action="Index">Admin</a> }
<form asp-controller="Account" asp-action="Logout" method="post"><button type="submit">Log out</button></form>
} else { <a asp-controller="Account" asp-action="Register">Register</a><a asp-controller="Account" asp-action="Login">Log in</a> }
</nav></header><main>@RenderBody()</main><footer>SafeVault coursework demo — no real financial data</footer>
</body></html>
