@model IReadOnlyList<VaultUser>
<h1>Admin dashboard</h1><p>Only administrators can access this page.</p>
<table><thead><tr><th>Username</th><th>Email</th><th>Role</th></tr></thead><tbody>
@foreach(var user in Model) { <tr><td>@user.Username</td><td>@user.Email</td><td>@user.Role</td></tr> }
</tbody></table>
